<div class="user-tutorials-banner">
  <Ui::PageTitle>
    <:title>{{t "pages.user-tutorials.title"}}</:title>
    <:subtitle>{{t "pages.user-tutorials.description"}}</:subtitle>
  </Ui::PageTitle>

  <ul class="user-tutorials-banner__filters">
    <li class="user-tutorials-banner-filters__filter">
      <PixToggleButton @route="authenticated.user-tutorials.show" @toggled={{this.filterToggleSwitched}} @onChange={{this.switchToggle}}>
        <:viewA><LinkTo @route="authenticated.user-tutorials.recommended"> {{t "pages.user-tutorials.recommended"}} </LinkTo></:viewA>
        <:viewB><LinkTo @route="authenticated.user-tutorials.saved"> {{t "pages.user-tutorials.saved"}} </LinkTo></:viewB>
      </PixToggleButton>
    </li>
    {{#if @shouldShowFilterButton}}
      <li class="user-tutorials-banner-filters__filter">
        <PixButton @variant="secondary" @isBorderVisible={{false}} @triggerAction={{@onTriggerFilterButton}}>
          {{t "pages.user-tutorials.filter"}}
        </PixButton>
      </li>
    {{/if}}
  </ul>
</div>